# /opt/birthdly/.env on the droplet. Created by hand; never commit the real file.

# The password of the stack's own Postgres. compose.yml builds the API's DATABASE_URL from it.
# Generate it on the server: openssl rand -hex 24 (it goes into a URL, so keep it URL-safe). Postgres takes it only when
# it creates the volume; to change it later, run ALTER ROLE birthdly PASSWORD '...' in psql first, then update it here.
POSTGRES_PASSWORD=<password>

# Sign-in with Google. The OAuth client in Google Cloud Console must list
# https://birthdly.com/api/auth/google/callback as an authorized redirect URI.
APP_ORIGIN=https://birthdly.com
GOOGLE_CLIENT_ID=<client id>
GOOGLE_CLIENT_SECRET=<client secret>
# Encrypts the sign-in cookie. Generate it on the server: openssl rand -hex 32
AUTH_SECRET=<secret>

LOG_LEVEL=info
