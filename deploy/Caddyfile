{
	servers {
		# Requests arrive through Cloudflare; the visitor's address is in CF-Connecting-IP.
		# Ranges from https://www.cloudflare.com/ips (checked 2026-11-16); keep in sync with the droplet firewall.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(site) {
	# Cloudflare Origin CA certificate: Cloudflare trusts it in the Full (strict) SSL mode; browsers never see it.
	tls /certs/origin.pem /certs/origin-key.pem
	encode zstd gzip
	log
}

# {args[0]} is the upstream. Only the visitor's address goes on, so the app does not take a Cloudflare address for the
# client.
(proxy) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
	}
}

# The web app redirects `www` to the main domain itself (apps/web/src/server.ts).
birthdly.com, www.birthdly.com {
	import site

	handle /api/* {
		import proxy api:3000
	}

	handle {
		import proxy web:4000
	}
}

# Kept until the web app calls the API under birthdly.com/api.
api.birthdly.com {
	import site
	import proxy api:3000
}
